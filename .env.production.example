# Product display name (frontend build-time counterpart of backend APP_NAME)
VITE_APP_NAME=Chief Connect
# ============================================================
# CRM FRONTEND - AWS COGNITO
# ============================================================
VITE_AUTH_PROVIDER=cognito

VITE_COGNITO_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/

# ============================================================
# BACKEND API
# ============================================================
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=dev
